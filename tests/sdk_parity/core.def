// Constants and layouts the core fakes reproduce from the pinned ESP-IDF and
// the Amity build's configuration. Layouts with pointers differ in size on
// the host, so for those only the field order is compared.
// fakes: tests/core_fakes
// headers: esp_err.h esp_log.h esp_timer.h esp_heap_caps.h esp_app_desc.h esp_app_format.h freertos/FreeRTOS.h
// target: main/main.cpp
