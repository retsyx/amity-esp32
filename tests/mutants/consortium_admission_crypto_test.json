      "find": "psa_import_key(&attributes,keys.data()+(server?0:32),32,&rx)",
      "replace": "psa_import_key(&attributes,keys.data()+(server?32:0),32,&rx)"
    },
    {
      "id": "replay-accepted",
      "check": "a replayed record is rejected",
      "file": "components/consortium/admission_crypto.cpp",
      "find": "sequence!=rx_sequence+1",
      "replace": "sequence>rx_sequence+1"
    },
