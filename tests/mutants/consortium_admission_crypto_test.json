      "id": "keys-not-destroyed",
      "check": "every PSA key a channel creates is destroyed with it",
      "file": "components/consortium/admission_crypto.cpp",
      "find": "~Channel(){if(ephemeral)psa_destroy_key(ephemeral);if(tx)psa_destroy_key(tx);if(rx)psa_destroy_key(rx);}",
      "replace": "~Channel(){}"
    },
    {
      "id": "ephemeral-kept",
      "check": "the ephemeral key is destroyed once the shared secret exists",
      "file": "components/consortium/admission_crypto.cpp",
      "find": "psa_destroy_key(ephemeral);ephemeral=0;",
      "replace": ";"
    },
