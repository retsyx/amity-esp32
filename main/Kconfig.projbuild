menu "HDMI adapter 5 (stable connector 4)"
config AMITY_TENTACLE4_FRONT_GPIO
    int "Front isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default -1
config AMITY_TENTACLE4_BACK_GPIO
    int "Back isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default -1
config AMITY_TENTACLE4_PRESENCE_GPIO
    int "Optional module presence input GPIO (-1 means unknown)"
    range -1 48
    default -1
config AMITY_TENTACLE4_PRESENT_HIGH
