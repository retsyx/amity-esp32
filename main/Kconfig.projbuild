# Development mappings are compiled independently of portable system configuration.
menu "Amity board profile"

choice AMITY_BOARD_PROFILE
    prompt "CEC carrier profile"
    default AMITY_BOARD_LEGACY_1T

config AMITY_BOARD_LEGACY_1T
    bool "Existing Amity board2 (one HDMI adapter, GPIO1/GPIO2)"

config AMITY_BOARD_DEVELOPMENT_4T
    bool "Development carrier (up to four optional HDMI adapters)"
    help
        Experimental GPIO mapping for a custom isolated-CEC carrier. Every
        connector retains its index 0..3. Defaults use the standard XIAO
        ESP32-S3 edge headers: front/back GPIO pairs 1/2, 5/6, 7/8 and 9/44.
        GPIO4 remains available for the setup/reset button;
        GPIO3 (strapping) and GPIO43 (ROM UART
        transmit) are not used. Override GPIO assignments to match the carrier.
        Set both GPIOs to -1 to disable a connector. No cable or module
        presence is inferred from CEC silence.
        This selection does not qualify electrical loading or eight-line timing.
endchoice

if AMITY_BOARD_DEVELOPMENT_4T
config AMITY_BOARD_RESET_GPIO
    int "Optional active-low setup/reset button GPIO (-1 disables)"
    range -1 48
    default -1

menu "HDMI adapter 1 (stable connector 0)"
config AMITY_TENTACLE0_FRONT_GPIO
    int "Front isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 1
config AMITY_TENTACLE0_BACK_GPIO
    int "Back isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 2
config AMITY_TENTACLE0_PRESENCE_GPIO
    int "Optional module presence input GPIO (-1 means unknown)"
    range -1 48
    default -1
config AMITY_TENTACLE0_PRESENT_HIGH
    bool "Presence input is high when the module is attached"
    default y
config AMITY_TENTACLE0_PRESENCE_PULLUP
    bool "Enable presence input pull-up (only if required by wiring)"
    default n
config AMITY_TENTACLE0_PRESENCE_PULLDOWN
    bool "Enable presence input pull-down (only if required by wiring)"
    depends on !AMITY_TENTACLE0_PRESENCE_PULLUP
    default n
endmenu

menu "HDMI adapter 2 (stable connector 1)"
config AMITY_TENTACLE1_FRONT_GPIO
    int "Front isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 5
config AMITY_TENTACLE1_BACK_GPIO
    int "Back isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 6
config AMITY_TENTACLE1_PRESENCE_GPIO
    int "Optional module presence input GPIO (-1 means unknown)"
    range -1 48
    default -1
config AMITY_TENTACLE1_PRESENT_HIGH
    bool "Presence input is high when the module is attached"
    default y
config AMITY_TENTACLE1_PRESENCE_PULLUP
    bool "Enable presence input pull-up (only if required by wiring)"
    default n
config AMITY_TENTACLE1_PRESENCE_PULLDOWN
    bool "Enable presence input pull-down (only if required by wiring)"
    depends on !AMITY_TENTACLE1_PRESENCE_PULLUP
    default n
endmenu

menu "HDMI adapter 3 (stable connector 2)"
config AMITY_TENTACLE2_FRONT_GPIO
    int "Front isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 7
config AMITY_TENTACLE2_BACK_GPIO
    int "Back isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 8
config AMITY_TENTACLE2_PRESENCE_GPIO
    int "Optional module presence input GPIO (-1 means unknown)"
    range -1 48
    default -1
config AMITY_TENTACLE2_PRESENT_HIGH
    bool "Presence input is high when the module is attached"
    default y
config AMITY_TENTACLE2_PRESENCE_PULLUP
    bool "Enable presence input pull-up (only if required by wiring)"
    default n
config AMITY_TENTACLE2_PRESENCE_PULLDOWN
    bool "Enable presence input pull-down (only if required by wiring)"
    depends on !AMITY_TENTACLE2_PRESENCE_PULLUP
    default n
endmenu

menu "HDMI adapter 4 (stable connector 3)"
config AMITY_TENTACLE3_FRONT_GPIO
    int "Front isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 9
config AMITY_TENTACLE3_BACK_GPIO
    int "Back isolated CEC GPIO (-1 disables connector)"
    range -1 48
    default 44
config AMITY_TENTACLE3_PRESENCE_GPIO
    int "Optional module presence input GPIO (-1 means unknown)"
    range -1 48
    default -1
config AMITY_TENTACLE3_PRESENT_HIGH
    bool "Presence input is high when the module is attached"
    default y
config AMITY_TENTACLE3_PRESENCE_PULLUP
    bool "Enable presence input pull-up (only if required by wiring)"
    default n
config AMITY_TENTACLE3_PRESENCE_PULLDOWN
    bool "Enable presence input pull-down (only if required by wiring)"
    depends on !AMITY_TENTACLE3_PRESENCE_PULLUP
    default n
endmenu

endif
endmenu

menu "Amity admission"

config AMITY_ADMISSION_REQUIRE_SETUP_CODE
    bool "Require the printed setup code when adding Amity"
    default n
    help
        By default, an unclaimed device is added through a physically opened
        setup window using ephemeral key exchange and encrypted messages.

        Enable this option to require the candidate's existing printed Matter
        manual setup code or QR code through a password-authenticated exchange.
        The original controller and candidate must use the same setting;
        mismatched profiles are rejected without falling back to another mode.

        This authenticates only Amity admission. It does not commission Matter,
        create a Matter fabric, or change the device's controller/member role.
        No separate Add to Amity secret is provisioned or stored.

endmenu
