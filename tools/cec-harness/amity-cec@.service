[Unit]
Description=Amity virtual HDMI-CEC device on harness GPIO %i
After=systemd-udev-trigger.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
SupplementaryGroups=video
ExecStart=/usr/local/lib/amity-cec-harness/device.sh %i
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
