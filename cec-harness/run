#!/bin/sh
set -eu
harness_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
runtime_python="$harness_dir/../.harness-python/bin/python"
if [ ! -x "$runtime_python" ]; then
    printf 'Harness runtime missing; rerun: sudo python3 "%s/setup.py"\n' "$harness_dir" >&2
    exit 1
fi
exec "$runtime_python" -B "$harness_dir/run.py" "$@"
