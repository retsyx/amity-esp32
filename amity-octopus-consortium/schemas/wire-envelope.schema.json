{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amity.invalid/design/v0.1/wire-envelope.schema.json",
  "title": "Authenticated scoped owner intents and supported management envelopes",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 1
    },
    "consortium_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "message_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "origin_octopus_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "origin_boot_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "destination_octopus_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "destination_boot_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "coordinator_epoch": {
      "$ref": "core-types.schema.json#/$defs/UInt64String"
    },
    "config_revision": {
      "$ref": "core-types.schema.json#/$defs/UInt64String"
    },
    "kind": {
      "enum": [
        "heartbeat",
        "execution_lease",
        "enrollment_control",
        "membership_event",
        "membership_result",
        "snapshot_request",
        "snapshot_chunk",
        "update_begin",
        "update_chunk",
        "update_install",
        "update_status",
        "update_abort",
        "update_result",
        "device_status",
        "settings_read",
        "settings_write",
        "settings_result",
        "scoped_intent",
        "scoped_result",
        "synchronization"
      ]
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "consortium_id",
    "message_id",
    "origin_octopus_id",
    "origin_boot_id",
    "destination_octopus_id",
    "destination_boot_id",
    "coordinator_epoch",
    "config_revision",
    "kind",
    "ttl_ms",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "synchronization"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/Synchronization"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "heartbeat"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/Heartbeat"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "execution_lease"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/Lease"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "enrollment_control"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/EnrollmentControl"
          }
        }
