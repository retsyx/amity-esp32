      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/SnapshotChunk"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_begin"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateBegin"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_chunk"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateChunk"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_install"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateInstall"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateStatus"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_abort"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateAbort"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "update_result"
          }
