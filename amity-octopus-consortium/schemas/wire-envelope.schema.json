      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/MembershipEvent"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "membership_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/MembershipResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "snapshot_request"
