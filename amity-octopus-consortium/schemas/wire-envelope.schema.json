        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "membership_event",
              "membership_result"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "ttl_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          }
        }
      }
    }
  ]
}
