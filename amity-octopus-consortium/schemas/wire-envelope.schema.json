          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/UpdateResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "device_status"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/DeviceStatus"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "settings_read"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/SettingsRead"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "settings_write"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/SettingsWrite"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "settings_result"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "https://amity.invalid/implementation/consortium/v1/payloads.schema.json#/$defs/SettingsResult"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
