{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amity.invalid/design/v0.1/core-types.schema.json",
  "title": "Amity proposed v0.1 core types",
  "$comment": "Owned by document03. Schema IDs are identifiers, not a deployed network service.",
  "$defs": {
    "Id128": {
      "type": "string",
      "minLength": 32,
      "maxLength": 32,
      "pattern": "^(?!0{32}$)[0-9a-f]{32}$",
      "description": "Canonical nonzero opaque 128-bit ID; examples are synthetic."
    },
    "UInt64String": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)$",
      "not": {
        "pattern": "[^0-9]"
      },
      "description": "Canonical decimal uint64 string, including explicit overflow rejection."
    },
    "CecPortRef": {
      "type": "object",
      "properties": {
        "consortium_id": {
          "$ref": "#/$defs/Id128"
        },
        "octopus_id": {
          "$ref": "#/$defs/Id128"
        },
        "tentacle_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "side": {
          "enum": [
            "front",
            "back"
          ]
        }
      },
      "required": [
        "consortium_id",
        "octopus_id",
        "tentacle_id",
        "side"
      ],
      "additionalProperties": false
    },
    "FullyQualifiedCecAddress": {
      "type": "object",
      "properties": {
        "consortium_id": {
          "$ref": "#/$defs/Id128"
        },
        "octopus_id": {
          "$ref": "#/$defs/Id128"
        },
        "tentacle_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "side": {
          "enum": [
            "front",
            "back"
          ]
        },
        "logical_address": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        }
      },
      "required": [
        "consortium_id",
        "octopus_id",
        "tentacle_id",
        "side",
        "logical_address"
      ],
      "additionalProperties": false,
      "description": "Resolved runtime execution locator only. Never use logical_address as a persisted configured device name or selector."
    },
    "QualifiedDeviceName": {
      "type": "object",
      "properties": {
        "consortium_id": {
          "$ref": "#/$defs/Id128"
        },
        "octopus_id": {
          "$ref": "#/$defs/Id128"
        },
        "tentacle_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "side": {
          "enum": [
            "front",
            "back"
          ]
        },
        "osd_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14,
          "description": "Exact nonempty OSD text from the shared CEC decoder, not the UI label. No case folding or trimming. The decoder also enforces the CEC payload octet budget; this schema checks decoded text only."
        }
      },
      "required": [
        "consortium_id",
        "octopus_id",
        "tentacle_id",
        "side",
        "osd_name"
      ],
      "additionalProperties": false,
      "description": "Persisted qualified device selector. Discovery resolves its exact OSD name to a separate runtime CEC address; no logical address is stored here."
    },
    "Hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$",
      "not": {
        "pattern": "[^a-z0-9-]"
      },
      "description": "Canonical lowercase DNS hostname label, 1\u201332 ASCII letters/digits/hyphens with alphanumeric ends; no display alias."
    }
  }
}
