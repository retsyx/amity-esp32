{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amity.invalid/design/v0.1/configuration.schema.json",
  "title": "Schema3 saved activity intent and qualified selectors",
  "type": "object",
  "properties": {
    "version": {
      "const": 3
    },
    "consortium_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "config_revision": {
      "allOf": [
        {
          "$ref": "core-types.schema.json#/$defs/UInt64String"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "presentation_revision": {
      "allOf": [
        {
          "$ref": "core-types.schema.json#/$defs/UInt64String"
        },
        {
          "not": {
            "const": "0"
          }
        }
      ]
    },
    "primary_zone_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "controller_octopus_id": {
      "$ref": "core-types.schema.json#/$defs/Id128"
    },
    "activity_order": {
      "type": "array",
      "items": {
        "$ref": "core-types.schema.json#/$defs/Id128"
      },
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true
    },
    "octopuses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "octopus_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "generated_label": {
            "type": "string",
            "maxLength": 128
          },
          "label_override": {
            "type": "boolean"
          },
          "supported_tentacles": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "required": [
          "octopus_id",
          "label",
          "generated_label",
          "label_override",
          "supported_tentacles"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "generated_label": {
            "type": "string",
            "maxLength": 128
          },
          "label_override": {
            "type": "boolean"
          },
          "kind": {
            "enum": [
              "source",
              "display",
              "receiver",
              "switch",
              "audio",
              "placeholder"
            ]
          },
          "qualified_names": {
            "type": "array",
            "items": {
              "$ref": "core-types.schema.json#/$defs/QualifiedDeviceName"
            },
            "minItems": 0,
            "maxItems": 1,
            "description": "One exact configured recipient. Empty only for a retained unresolved placeholder; never choose among multiple owner/adapter/name selectors."
          }
        },
        "required": [
          "component_id",
          "label",
          "generated_label",
          "label_override",
          "kind",
          "qualified_names"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "qualified_names": {
                  "maxItems": 0
                }
              }
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "placeholder"
                }
              }
            }
          }
        ]
      },
      "minItems": 0,
      "maxItems": 64
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "zone_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "generated_label": {
            "type": "string",
            "maxLength": 128
          },
          "label_override": {
            "type": "boolean"
          },
          "source": {
            "anyOf": [
              {
                "$ref": "core-types.schema.json#/$defs/Id128"
              },
              {
                "type": "null"
              }
            ]
          },
          "display": {
            "anyOf": [
              {
                "$ref": "core-types.schema.json#/$defs/Id128"
              },
              {
                "type": "null"
              }
            ]
          },
          "audio": {
            "anyOf": [
              {
                "$ref": "core-types.schema.json#/$defs/Id128"
              },
              {
                "type": "null"
              }
            ]
          },
          "switch_device": {
            "anyOf": [
              {
                "$ref": "core-types.schema.json#/$defs/Id128"
              },
              {
                "type": "null"
              }
            ]
          },
          "switch_input": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          }
        },
        "required": [
          "activity_id",
          "zone_id",
          "label",
          "generated_label",
          "label_override",
          "source",
          "display",
          "audio",
          "switch_device",
          "switch_input"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 64
    },
    "zones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "zone_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "label": {
            "type": "string",
            "maxLength": 128
          },
          "generated_label": {
            "type": "string",
            "maxLength": 128
          },
          "label_override": {
            "type": "boolean"
          },
          "activity_order": {
            "type": "array",
            "items": {
              "$ref": "core-types.schema.json#/$defs/Id128"
            },
            "minItems": 0,
            "maxItems": 64,
            "uniqueItems": true
          }
        },
        "required": [
          "zone_id",
          "label",
          "generated_label",
          "label_override",
          "activity_order"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 16
    },
    "external_slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "activity_id": {
            "$ref": "core-types.schema.json#/$defs/Id128"
          },
          "tombstone": {
            "type": "boolean"
          },
          "hidden": {
            "type": "boolean"
          },
          "alias": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "slot",
          "activity_id",
          "tombstone",
          "hidden",
          "alias"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 16
    },
    "quirks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component_id": {
            "anyOf": [
              {
                "$ref": "core-types.schema.json#/$defs/Id128"
              },
              {
                "type": "null"
              }
            ]
          },
          "vendor_id": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16777215
          },
          "power_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 0,
            "maxItems": 15
          },
          "power_off": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 0,
            "maxItems": 15
          }
        },
        "required": [
          "component_id",
          "vendor_id",
          "power_on",
          "power_off"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 32
    }
  },
  "required": [
    "version",
    "consortium_id",
    "config_revision",
    "presentation_revision",
    "primary_zone_id",
    "octopuses",
    "components",
    "activities",
    "zones",
    "external_slots",
    "quirks",
    "controller_octopus_id"
  ],
  "additionalProperties": false
}
